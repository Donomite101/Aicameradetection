# Database
DB_USER=sih_user
DB_PASSWORD=sih_password
DB_NAME=sih_monitor
DATABASE_URL=postgresql://sih_user:sih_password@localhost:5432/sih_monitor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_THUMBNAILS=sih-thumbnails
MINIO_BUCKET_CLIPS=sih-clips
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Edge Device (for reference)
EDGE_MQTT_BROKER=mqtt://localhost:1883
EDGE_DEVICE_ID=edge-001
EDGE_CENTRE_ID=centre-001

# AI Models
YOLO_MODEL_PATH=./models/yolov8n.onnx
POSE_MODEL_PATH=./models/pose.onnx
FACE_DETECTION_MODEL=mediapipe

# Detection Thresholds
PERSON_CONF_THRESHOLD=0.5
PERSON_IOU_THRESHOLD=0.45
EQUIPMENT_CONF_THRESHOLD=0.4
ATTENDANCE_DISCREPANCY_THRESHOLD=2
INFRASTRUCTURE_CHECK_INTERVAL=300000

# Privacy
ENABLE_FACE_BLUR=true
BLUR_KERNEL_SIZE=51
STORE_RAW_FRAMES=false

# Low Bandwidth Mode
LOW_BANDWIDTH_MODE=false
METADATA_ONLY_UPLOAD=false
FRAME_SKIP_INTERVAL=2