generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          String    @default("VIEWER") // ADMIN, MONITORING_OFFICER, CENTRE_MANAGER, VIEWER
  centreId      String?
  centre        Centre?   @relation(fields: [centreId], references: [id])
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([centreId])
}

model Centre {
  id                  String          @id @default(cuid())
  code                String          @unique
  name                String
  address             String
  city                String
  state               String
  pincode             String
  latitude            Float
  longitude           Float
  sanctionedCapacity  Int
  status              String          @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  contactPerson       String?
  contactPhone        String?
  contactEmail        String?
  area                String?
  totalTrainees       Int             @default(0)
  schemeId            String?
  scheme              Scheme?         @relation(fields: [schemeId], references: [id])
  schemeName          String?
  classSlots          ClassSlot[]
  cameras             Camera[]
  inventory           InventoryItem[]
  attendanceRecords   AttendanceRecord[]
  infrastructureChecks InfrastructureCheck[]
  alerts              Alert[]
  users               User[]
  trainees            Trainee[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([code])
  @@index([status])
  @@index([latitude, longitude])
}

model Camera {
  id          String   @id @default(cuid())
  centreId    String
  centre      Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("IP") // WEBCAM (laptop), PHONE (mobile app), IP (RTSP camera)
  rtspUrl     String?             // only for IP cameras
  roi         String?             // JSON string of Region of Interest polygon coordinates
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([centreId])
  @@index([isActive])
}

model InventoryItem {
  id          String            @id @default(cuid())
  centreId    String
  centre      Centre            @relation(fields: [centreId], references: [id], onDelete: Cascade)
  name        String
  category    String            // MACHINERY, FURNITURE, SAFETY, TOOLS, COMPUTERS, OTHER
  quantity    Int
  unit        String            @default("PCS")
  specs       String?           // JSON string of specifications
  location    String?           // Room/area within centre
  detectClass String?           // Detector class name (e.g. laptop) used for exact matching
  isActive    Boolean           @default(true)
  checks      InfrastructureCheck[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([centreId])
  @@index([category])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  centreId      String
  centre        Centre           @relation(fields: [centreId], references: [id], onDelete: Cascade)
  classSlotId   String?
  classSlot     ClassSlot?       @relation(fields: [classSlotId], references: [id], onDelete: SetNull)
  date          DateTime
  session       String           // Class slot name (or MORNING, AFTERNOON, EVENING, FULL_DAY for manual records)
  recordedCount Int
  expectedCount Int              @default(0)
  detectedCount Int?
  peakCount     Int?
  finalCount    Int?             // highest steady headcount, fixed when the class ends
  avgCount      Float?
  minCount      Int?
  sampleCount   Int              @default(0)
  firstSeenAt   DateTime?
  lastSeenAt    DateTime?
  primaryCameraId String?        // the one camera whose readings count for this session (prevents double counting)
  toolsSummary  String?          // JSON: [{itemId,name,detectClass,expected,maxDetected,lastDetected}]
  finalizedAt   DateTime?
  discrepancy   Int?
  status        String           @default("PENDING") // PENDING, VERIFIED, DISCREPANT, UNDER_REVIEW
  confidence    Float?           // Average detection confidence
  metadata      String?          // JSON string of additional detection data
  submittedBy   String?          // User ID who submitted
  verifiedBy    String?          // User ID who verified
  verifiedAt    DateTime?
  snapshots     DetectionSnapshot[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([centreId, date, session])
  @@index([centreId, date])
  @@index([classSlotId])
  @@index([status])
}

model ClassSlot {
  id               String   @id @default(cuid())
  centreId         String
  centre           Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  name             String
  startTime        String   // HH:mm
  endTime          String   // HH:mm
  daysOfWeek       String   @default("1,2,3,4,5,6") // CSV of 0 (Sun) - 6 (Sat)
  expectedTrainees Int?     // falls back to Centre.totalTrainees
  isActive         Boolean  @default(true)
  attendanceRecords AttendanceRecord[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([centreId])
}

model DetectionSnapshot {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  cameraId           String
  timestamp          DateTime         @default(now())
  peopleCount        Int
  confidence         Float
  items              String           @default("[]") // JSON: [{name,count,confidence}]

  @@index([attendanceRecordId, timestamp])
}

model InfrastructureCheck {
  id              String              @id @default(cuid())
  centreId        String
  centre          Centre              @relation(fields: [centreId], references: [id], onDelete: Cascade)
  itemId          String
  item            InventoryItem       @relation(fields: [itemId], references: [id])
  timestamp       DateTime            @default(now())
  detected        Boolean
  operability     String              @default("UNKNOWN") // FUNCTIONAL, NON_FUNCTIONAL, UNKNOWN, MAINTENANCE
  confidence      Float
  personNearby    Boolean             @default(false)
  thumbnailUrl    String?
  metadata        String?             // JSON string of bounding boxes, additional info
  createdAt       DateTime            @default(now())

  @@index([centreId, timestamp])
  @@index([itemId, timestamp])
  @@index([detected])
}

model Alert {
  id          String        @id @default(cuid())
  centreId    String
  centre      Centre        @relation(fields: [centreId], references: [id], onDelete: Cascade)
  type        String        // ATTENDANCE_DISCREPANCY, EQUIPMENT_MISSING, EQUIPMENT_NON_FUNCTIONAL, CAMERA_OFFLINE, LOW_CONFIDENCE
  severity    String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title       String
  message     String
  metadata    String        // JSON string of detection details, counts, etc.
  status      String        @default("OPEN") // OPEN, ACKNOWLEDGED, IN_PROGRESS, RESOLVED, FALSE_POSITIVE, DISMISSED
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([centreId, status])
  @@index([type, severity])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  category  String
  description String?
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  String?  // JSON string
  newValue  String?  // JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Trainee {
  id              String              @id @default(cuid())
  centreId        String
  centre          Centre              @relation(fields: [centreId], references: [id], onDelete: Cascade)
  registrationNo  String              @unique
  fullName        String
  email           String?
  phone           String?
  gender          String?             // MALE, FEMALE, OTHER
  dateOfBirth     DateTime?
  aadhaarLast4    String?
  courseName      String?
  batchName       String?
  schemeCode      String?
  status          String              @default("ACTIVE") // ACTIVE, COMPLETED, DROPOUT, SUSPENDED
  photoUrl        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  attendance      TraineeAttendance[]

  @@index([centreId])
  @@index([registrationNo])
  @@index([status])
}

model TraineeAttendance {
  id          String   @id @default(cuid())
  traineeId   String
  trainee     Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  centreId    String
  date        DateTime
  session     String   // MORNING, AFTERNOON, EVENING, FULL_DAY
  status      String   @default("PRESENT") // PRESENT, ABSENT, LEAVE
  markedBy    String?  // User ID who marked
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([traineeId, date, session])
  @@index([centreId, date])
  @@index([traineeId])
}

model Scheme {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String?
  ministry            String?  // e.g. Ministry of Skill Development and Entrepreneurship
  fundingType         String?  // CENTRAL, STATE, PPP
  targetBeneficiaries Int?
  isActive            Boolean  @default(true)
  centres             Centre[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([code])
}